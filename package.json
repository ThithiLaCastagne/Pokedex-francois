{
  "name": "pokedex-de-la-faune",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/collection-browser.mjs && node scripts/sw-update-browser.mjs",
    "test:db": "node scripts/test-circle-db.mjs",
    "test:a11y": "node scripts/audit-accessibility.mjs",
    "test:cloud": "node scripts/run-cloud-test.mjs",
    "format": "prettier --write src scripts index.html README.md docs/*.md",
    "format:check": "prettier --check src scripts index.html README.md docs/*.md"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "leaflet": "1.9.4",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
